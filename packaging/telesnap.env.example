# Required. Generate a long random value and keep it secret.
TELESNAP_API_TOKEN=CHANGE_ME

TELESNAP_BIND=127.0.0.1:8080
TELESNAP_STATE_PATH=/var/lib/telesnap/expirations.json
TELESNAP_UPLOAD_DIR=/var/lib/telesnap/uploads

# Optional policy limits. Omit a setting to use the daemon default.
# TELESNAP_MAX_UPLOAD_BYTES=2147483648
# TELESNAP_MAX_LIFETIME_SECONDS=86400
# TELESNAP_COMMAND_TIMEOUT_SECONDS=300
# TELESNAP_PENDING_TIMEOUT_SECONDS=600
# TELESNAP_UPLOAD_TIMEOUT_SECONDS=3600
RUST_LOG=telesnap=info
